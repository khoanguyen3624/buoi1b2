@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
    <style>
        ul {
            margin: 8px 0 0 18px;
            padding: 0;
        }

        .img-box {
            width: 70px;
            height: 70px;
            border: 1px solid #000;
            text-align: center;
            line-height: 70px;
            margin-left: 8px;
            float: right;
        }
    </style>

</head>
<body>
    <table border="1" width="700" align="center" cellspacing="0" cellpadding="10">
        <tr>
            <td width="150" valign="top">
                <strong>Danh sách các mục liên kết</strong>
                <ul>
                    <li>Liên kết 1</li>
                    <li>Liên kết 2</li>
                    <li>Liên kết 3</li>
                    <li>Liên kết 4</li>
                </ul>
            </td>

            <td valign="top">
                <table border="1" width="100%" cellspacing="0" cellpadding="10" style="border-collapse:collapse;">
                    <tr>
                        <td colspan="2"  height="80"><h2>   Logo</h2></td>
                    </tr>
                    <tr>
                        <td width="62%" valign="top" rowspan="2">
                            <h3>Nội dung 1</h3>
                            <div class="img-box">Hình</div>
                            <p>Đoạn văn bản mẫu... </p>
                            <p>Đoạn văn bản mẫu...</p>
                            <p>Đoạn văn bản mẫu... .</p>
                            <div class="clear"></div>
                        </td>
                        <td width="38%" valign="top">
                            <h3>Nội dung 2</h3>
                            <ul>
                                <li>Mục 1</li>
                                <li>Mục 2</li>
                                <li>Mục 3</li>
                            </ul>
                        </td>
                    </tr>

                    <tr>
                        <td valign="top">
                            <h3>Nội dung 3</h3>

                            <div style="float:right; width:70px; height:70px; border:1px solid #000; text-align:center; line-height:70px; margin-left:10px;">
                                Hình
                            </div>
                            <p>Đoạn văn bản mẫu... .</p>
                            <p>Đoạn văn bản mẫu... .</p>
                            <div style="clear:both;"></div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
  

</body>
</html>
