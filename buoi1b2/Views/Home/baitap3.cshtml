        <div style="display:flex; height:80px;">
            <div style="width:250px; border:1px solid black; box-sizing:border-box;"></div>
            <div style="flex:1; border:1px solid black; box-sizing:border-box;"></div>
        </div>

        <div style="height:50px; border:1px solid black; box-sizing:border-box;"></div>

        <div style="display:flex; flex:1;">
            <div style="width:150px; border:1px solid black; box-sizing:border-box;"></div>
            <div style="flex:1; border:1px solid black; box-sizing:border-box;"></div>
        </div>

    </div>
    <br />
    <div style="width:600px; height:400px; border:1px solid black; box-sizing:border-box;
        display:flex; flex-direction:column;">

        <div style="display:flex; height:80px;">
            
            <div style="flex:1; border:1px solid black; box-sizing:border-box;"></div>
        </div>

        <div style="height:50px; border:1px solid black; box-sizing:border-box;"></div>

        <div style="display:flex; flex:1;">
            <div style="width:150px; border:1px solid black; box-sizing:border-box;"></div>
            <div style="flex:1; border:1px solid black; box-sizing:border-box;"></div>
        </div>

    </div>







</body>
</html>
