@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
</head>
<body>
    <div style="width: 800px; margin: 0 auto; border: 1px solid black;">
        <div style="display: flex; height: 80px;">
            <div style="width: 30%; border: 1px solid black; padding: 10px;">

            </div>
            <div style="width: 70%; border: 1px solid black; padding: 10px;">

            </div>

        </div>
        <div style="display: flex; height: 300px;">
            <div style="width: 15%; border: 1px solid black; padding: 10px;">
            </div>
            <div style="width: 70%; border: 1px solid black; padding: 10px;">

            </div>
            <div style="width: 15%; border: 1px solid black; padding: 10px;">

            </div>
        </div>
        <div style="border: 1px solid black; padding: 30px;">

        </div>

    </div>
    <br />
    <div style="width:600px; height:400px; border:1px solid black;">

        <div style="width:100%; height:70px; border:1px solid black; ">

        </div>

        <div style="display:flex; height:330px;">

            <div style="width:100px; border:1px solid black; ">

            </div>


            <div style="flex:1; border:1px solid black;">

            </div>
        </div>

    </div>
    <br />
    <div style="width:600px; height:400px; border:1px solid black; box-sizing:border-box;">

        <div style="width:100%; height:70px; border:1px solid black; box-sizing:border-box;">
        </div>
        <div style="display:flex; height:330px;">
            <div style="flex:1; border:1px solid black; box-sizing:border-box;">
            </div>
            <div style="width:100px; border:1px solid black; box-sizing:border-box;">
            </div>
        </div>

    </div>
    <br />
    <div style="width:600px; height:400px; border:1px solid black; box-sizing:border-box;">


        <div style="width:100%; height:70px; border:1px solid black; box-sizing:border-box;">
        </div>


        <div style="display:flex; height:260px;">

            <div style="flex:1; border:1px solid black; box-sizing:border-box;">
            </div>


            <div style="width:100px; border:1px solid black; box-sizing:border-box;">
            </div>
        </div>


        <div style="width:100%; height:70px; border:1px solid black; box-sizing:border-box;">
        </div>

    </div>
    <br />
    <div style="width:600px; height:400px; border:1px solid black; box-sizing:border-box;
